<a href="#contato" class="whatsapp">WhatsApp</a>

<script>
// CONFIGURAÇÃO DO WHATSAPP
// Substitua pelo número da loja com DDI e DDD.
// Exemplo: 5516999999999
const WHATSAPP_NUMBER = "";

function openWhatsApp(){
  if(!/^55\d{10,11}$/.test(WHATSAPP_NUMBER)){
    alert("O WhatsApp da loja ainda precisa ser configurado.");
    return;
  }
  const message = encodeURIComponent(
    "Olá! Conheci a SCOOTERS BR pelo site e gostaria de informações sobre as scooters."
  );
  window.open(
    "https://wa.me/"+WHATSAPP_NUMBER+"?text="+message,
    "_blank"
  );
}

document.getElementById("contact-button").addEventListener("click",function(e){
  e.preventDefault();
  openWhatsApp();
});

document.querySelector(".whatsapp").addEventListener("click",function(e){
  e.preventDefault();
  openWhatsApp();
});
</script>
